PORT=4000
NODE_ENV=development

# Supabase Postgres Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis Cache & Idempotency Store
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_TTL_SECONDS=86400

# Namecheap Production Registry XML API
NAMECHEAP_API_KEY=your-namecheap-api-key
NAMECHEAP_API_USER=your-namecheap-api-user
NAMECHEAP_USERNAME=your-namecheap-username
NAMECHEAP_EMAIL=your-email@example.com
NAMECHEAP_NAME=Your Name
NAMECHEAP_CLIENT_IP=your-whitelisted-ip
NAMECHEAP_BASE_URL=https://api.namecheap.com/xml.response

# Swychr / AccountPe Mobile Money Settlement Rail
SWYCHR_API_KEY=your-swychr-api-key
SWYCHR_BASE_URL=https://api.accountpe.com

# Google SMTP Mailer Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Oneallhost Billing <billing@oneallhost.com>"
