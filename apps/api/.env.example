PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
DEV_ADMIN_PASSWORD=dev-admin-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase Postgres Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis Cache & Idempotency Store
REDIS_URL=redis://localhost:6379
IDEMPOTENCY_TTL_SECONDS=86400

# Namecheap Production Registry XML API
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=
NAMECHEAP_USERNAME=
NAMECHEAP_EMAIL=
NAMECHEAP_NAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_BASE_URL=https://api.namecheap.com/xml.response

# Swychr / AccountPe Mobile Money Settlement Rail
SWYCHR_API_KEY=
SWYCHR_BASE_URL=https://api.accountpe.com
SWYCHR_WEBHOOK_SECRET=

# Google SMTP Mailer Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oneallhost Billing <billing@oneallhost.com>"
